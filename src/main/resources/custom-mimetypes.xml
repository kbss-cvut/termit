<?xml version="1.0" encoding="UTF-8"?>
<mime-info>
    <mime-type type="text/turtle">
        <sub-class-of type="text/plain"/>
        <glob pattern="*.ttl"/>
        <glob pattern="*.ttls"/>
        <magic priority="70">
            <match value="@prefix" type="stringignorecase" offset="0" />
        </magic>
        <magic priority="60">
            <match value="prefix" type="stringignorecase" offset="0" />
        </magic>
        <magic priority="60">
            <match value="base" type="stringignorecase" offset="0" />
        </magic>
    </mime-type>
    <mime-type type="application/n-triples">
        <sub-class-of type="text/plain"/>
        <glob pattern="*.nt"/>
        <magic priority="70">
            <match value="&lt;&lt;" type="string" offset="0" />
        </magic>
    </mime-type>
</mime-info>
